# Copy to .env.local and fill in. Never commit .env.local.
# Values for local development come from `npx supabase status` after `npx supabase start`.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS. Used only by public form Route Handlers and dev scripts.
SUPABASE_SERVICE_ROLE_KEY=
